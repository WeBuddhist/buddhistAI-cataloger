OPENPECHA_ENDPOINT=
API_ENDPOINT=
BDRC_SEARCH_ENDPOINT=
# BDRC IIIF image proxy (Authorization: XBdrcKey <base64>)
IMAGE_PROXY_BDRC_KEY=
PORT=8000

# Auth0 access token verification (outliner API + image proxy)
# Domain only, e.g. dev-xxx.us.auth0.com (no https://)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

TRANSLATION_BACKEND_URL=

# BEC OT API (admin dashboard volume-batch stats); default is production
BEC_OTAPI_BASE_URL=https://bec-otapi.bdrc.io

# Monlam AI speech-to-text (Deduplicator voice notes). Organisation key; server-side only.
MONLAM_API_BASE_URL=https://api-v1.monlamai.studio
MONLAM_API_KEY=

# S3 bucket for Deduplicator voice-note audio (private). Credentials of an IAM user
# allowed only s3:PutObject/GetObject/DeleteObject on <bucket>/dedup/voice-notes/*.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=dedup-voice-notes-2026